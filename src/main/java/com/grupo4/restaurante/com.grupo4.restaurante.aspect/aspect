
package com.grupo4.restaurante.aspect;

import org.aspectj.lang.ProceedingJoinPoint;
import org.aspectj.lang.annotation.Around;
import org.aspectj.lang.annotation.Aspect;
import org.springframework.stereotype.Component;

import java.time.LocalDateTime;

@Aspect
@Component
public class AuditoriaAspect {

    @Around("execution(* com.grupo4.restaurante.service..*(..))")
    public Object registrarEjecucion(ProceedingJoinPoint joinPoint)
            throws Throwable {

        String metodo = joinPoint.getSignature().toShortString();

        System.out.println("==================================");
        System.out.println("AOP - AUDITORIA DE NEGOCIO");
        System.out.println("Fecha: " + LocalDateTime.now());
        System.out.println("Método ejecutado: " + metodo);

        long inicio = System.currentTimeMillis();

        try {
            Object resultado = joinPoint.proceed();

            long duracion = System.currentTimeMillis() - inicio;

            System.out.println("Resultado: EJECUCIÓN EXITOSA");
            System.out.println("Tiempo: " + duracion + " ms");

            return resultado;

        } catch (Throwable error) {

            System.out.println("Resultado: ERROR");
            System.out.println("Detalle: " + error.getMessage());

            throw error;

        } finally {
            System.out.println("==================================");
        }
    }
}
