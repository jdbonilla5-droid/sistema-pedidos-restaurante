
package com.grupo4.restaurante.interceptor;

import org.springframework.boot.web.servlet.FilterRegistrationBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.Ordered;

@Configuration
public class WebConfig {

    @Bean
    public FilterRegistrationBean<RegistroSolicitudesFilter>
            registroSolicitudesFilter() {

        FilterRegistrationBean<RegistroSolicitudesFilter> registration =
                new FilterRegistrationBean<>();

        registration.setFilter(new RegistroSolicitudesFilter());
        registration.addUrlPatterns("/api/*");
        registration.setName("registroSolicitudesFilter");
        registration.setOrder(Ordered.HIGHEST_PRECEDENCE);

        System.out.println("MIDDLEWARE: FILTRO REGISTRADO CORRECTAMENTE");

        return registration;
    }
}
